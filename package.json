{
  "name": "friendly-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "workers/image-proxy"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && npm run typecheck --workspace @friendly/image-proxy",
    "test": "vitest run && npm test --workspace @friendly/image-proxy",
    "proxy:dev": "npm run dev --workspace @friendly/image-proxy",
    "proxy:build": "npm run build --workspace @friendly/image-proxy",
    "proxy:deploy": "npm run deploy --workspace @friendly/image-proxy",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run check:architecture && prettier --check . && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-router": "^7.18.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "sharp": "0.35.5"
  }
}
