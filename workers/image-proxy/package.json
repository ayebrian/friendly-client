{
  "name": "@friendly/image-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "types": "wrangler types worker-configuration.d.ts",
    "typecheck": "npm run types && tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && wrangler deploy --env \"\" --dry-run --outdir dist",
    "deploy": "wrangler deploy --env \"\""
  },
  "dependencies": {
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "wrangler": "4.146.0",
    "@cloudflare/vitest-plugin": "1.3.4",
    "vitest": "^4.1.0"
  }
}
