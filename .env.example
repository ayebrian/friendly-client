# Public API origin for media URLs. API requests go through the same-origin /api proxy.
VITE_API_BASE_URL=https://api.getfriend.ly
# Upstream of the /api proxy (Pages Function, and npm run dev / vite preview). Not a secret.
FRIENDLY_API_ORIGIN=https://api.getfriend.ly
# Set after deploying the image Worker. Blank keeps explicit external-media loading.
VITE_IMAGE_PROXY_URL=
